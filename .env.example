# ---- Public site ----
# Set once your custom domain is connected in Vercel (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.nissiupvcgroups.com

# ---- Supabase (lead database) - run supabase-schema.sql first ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Lead dashboard login (/admin/login) ----
ADMIN_USERNAME=nissi_admin
ADMIN_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD
# 32+ random characters. Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_32_PLUS_CHARS

# Optional: Bearer token for scripts/integrations calling the admin APIs
ADMIN_TOKEN=

# ---- Email alerts (optional, needs verified domain in Resend) ----
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=nissiupvcprofiles@gmail.com

# ---- SEO (optional) ----
# Paste the verification code Google Search Console / Bing Webmaster gives you
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
